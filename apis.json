[
  {
    "name": "JSONPlaceholder Users (GET)",
    "url": "https://jsonplaceholder.typicode.com/users",
    "method": "GET",
    "expected_status": 200,
    "max_latency_ms": 3000,
    "expected_keys": ["id", "name", "email"],
    "expected_headers": {
      "content-type": "application/json"
    },
    "check_ssl_cert": true,
    "min_ssl_days": 14
  },
  {
    "name": "Secure Post Creation (POST with Bearer Token)",
    "url": "https://httpbin.org/post",
    "method": "POST",
    "auth": {
      "type": "bearer",
      "token": "${AUTH_BEARER_TOKEN:-default_secret_token_123}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "json": {
      "title": "API Health Monitor Post Check",
      "body": "Automated payload check for POST request",
      "userId": 101
    },
    "expected_status": 200,
    "max_latency_ms": 4000,
    "expected_keys": ["data", "headers", "json"]
  },
  {
    "name": "Secure Resource Update (PUT with Bearer Token)",
    "url": "https://httpbin.org/put",
    "method": "PUT",
    "auth": {
      "type": "bearer",
      "token": "${AUTH_BEARER_TOKEN:-default_secret_token_123}"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "json": {
      "id": 101,
      "title": "API Health Monitor Updated Title",
      "status": "active"
    },
    "expected_status": 200,
    "max_latency_ms": 4000,
    "expected_keys": ["data", "headers", "json"]
  },
  {
    "name": "JSONPlaceholder Delete Post (DELETE)",
    "url": "https://jsonplaceholder.typicode.com/posts/1",
    "method": "DELETE",
    "expected_status": [200, 204],
    "max_latency_ms": 3000
  },
  {
    "name": "Deliberate 404 Failure Check",
    "url": "https://jsonplaceholder.typicode.com/non_existent_page_12345",
    "method": "GET",
    "expected_status": 200,
    "max_latency_ms": 3000,
    "expected_keys": []
  }
]